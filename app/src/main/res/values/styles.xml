<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#166C63</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F5F3</item>
        <item name="android:navigationBarColor">#F2F5F3</item>
        <item name="android:windowBackground">#F2F5F3</item>
    </style>
    <style name="SectionTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#193B35</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
