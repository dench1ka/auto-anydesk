<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/page" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/app_name" android:textSize="26sp" android:textStyle="bold" android:textColor="#193B35" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/subtitle" android:textSize="14sp" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/status" style="@style/SectionTitle" />
        <TextView android:id="@+id/status_help" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" />
        <Switch android:id="@+id/auto_confirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="64dp" android:text="@string/auto_confirm" android:textSize="16sp" android:paddingEnd="4dp" android:paddingStart="0dp" android:layout_marginTop="12dp" />
        <CheckBox android:id="@+id/remember" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="@string/remember" android:textSize="15sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/notice" android:textSize="13sp" android:layout_marginTop="8dp" />
        <Button android:id="@+id/open_accessibility" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:textAllCaps="false" android:text="@string/open_accessibility" android:layout_marginTop="12dp" />
        <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:textAllCaps="false" android:text="@string/refresh" />
        <TextView style="@style/SectionTitle" android:text="@string/diagnostics" />
        <TextView android:id="@+id/diagnostic_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textIsSelectable="true" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/click_notice" android:textSize="13sp" android:layout_marginTop="12dp" />
        <TextView style="@style/SectionTitle" android:text="@string/miui_title" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/miui_help" android:textSize="14sp" android:lineSpacingExtra="3dp" android:paddingBottom="20dp" />
    </LinearLayout>
</ScrollView>
